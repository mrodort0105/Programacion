-- Entrar a MariaDB: mariadb -u root -p
CREATE DATABASE IF NOT EXISTS tienda;
USE tienda;

CREATE TABLE IF NOT EXISTS productos (
    id INT PRIMARY KEY,
    nombre VARCHAR(50),
    descripcion VARCHAR(100),
    precio INT, -- Guardado en céntimos según los datos posteriores
    pais VARCHAR(50)
);

