import javax.persistence.*;
import java.math.BigDecimal;
import java.time.LocalDate;

public class Ejercicio4 {
    public static void main(String[] args) {
        EntityManagerFactory emf = Persistence.createEntityManagerFactory("objectdb:eventos.odb");
        EntityManager em = emf.createEntityManager();

        EventoMusical ev1 = new EventoMusical();
        ev1.setNombre("Festival Verano");
        ev1.setFecha(LocalDate.of(2026, 7, 20));
        ev1.setRecaudacion(new BigDecimal("50000"));
        ev1.setGenero(GeneroMusical.POP);

        EventoMusical ev2 = new EventoMusical();
        ev2.setNombre("Metal Absolute");
        ev2.setFecha(LocalDate.of(2026, 8, 05));
        ev2.setRecaudacion(new BigDecimal("85000"));
        ev2.setGenero(GeneroMusical.ROCK);

        em.getTransaction().begin();
        em.persist(ev1); // Generará ID 1 o 10 dependiendo de la secuencia
        em.persist(ev2);
        em.getTransaction().commit();

        em.close();
        emf.close();
        System.out.println("Eventos insertados con éxito.");
    }
}
