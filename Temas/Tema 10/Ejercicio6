import javax.persistence.*;

public class Ejercicio6 {
    public static void main(String[] args) {
        EntityManagerFactory emf = Persistence.createEntityManagerFactory("objectdb:eventos.odb");
        EntityManager em = emf.createEntityManager();
        em.getTransaction().begin();

        // 1. Modificar el primero mediante Identificador
        EventoMusical ev1 = em.find(EventoMusical.class, 1L);
        if(ev1 != null) {
            ev1.setNombre(ev1.getNombre().toUpperCase());
        }

        // 2. Modificar el segundo mediante JPQL Estático
        Query qEst = em.createQuery("UPDATE EventoMusical e SET e.nombre = UPPER(e.nombre) WHERE e.id = 11"); 
        // Nota: Asumiendo que el id del segundo es 11 debido al incremento de 10 en 10
        qEst.executeUpdate();

        // 3. Modificar el segundo mediante JPQL Dinámico
        Long idSegundo = 11L;
        Query qDin = em.createQuery("UPDATE EventoMusical e SET e.nombre = UPPER(e.nombre) WHERE e.id = :id");
        qDin.setParameter("id", idSegundo);
        qDin.executeUpdate();

        em.getTransaction().commit();
        em.close();
        emf.close();
    }
}
