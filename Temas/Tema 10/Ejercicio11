import java.sql.*;

public class Ejercicio11 {
    private static final String URL = "jdbc:mariadb://localhost:3306/tienda";
    private static final String USER = "Miguel";
    private static final String PASSWORD = "Miguel";

    public static void main(String[] args) {
        try (Connection conn = DriverManager.getConnection(URL, USER, PASSWORD);
             Statement stmt = conn.createStatement()) {

            // 1. Uso de execute() para mostrar productos españoles
            boolean tieneResultSet = stmt.execute("SELECT * FROM productos WHERE pais = 'Espana'");
            if (tieneResultSet) {
                try (ResultSet rs = stmt.getResultSet()) {
                    while (rs.next()) {
                        System.out.println("Producto Español: " + rs.getString("nombre") + " - " + rs.getInt("precio") + "cts");
                    }
                }
            }

            // 2. Ejecutar un nuevo lote (Batch) con las nuevas inserciones
            conn.setAutoCommit(false); // Recomendado para procesamiento por lotes

            stmt.addBatch("INSERT INTO productos VALUES (4, 'kiwi', 'Zaspri gold', 120, 'Nueva Zelanda')");
            stmt.addBatch("INSERT INTO productos VALUES (5, 'perito', 'Peritos de Tavizna', 18, 'Espana')");
            stmt.addBatch("INSERT INTO productos VALUES (6, 'plátano', 'Plátano canario', 40, 'Espana')");

            int[] resultados = stmt.executeBatch();
            conn.commit(); // Consolidar transacción
            System.out.println("Batch ejecutado con éxito. Registros afectados: " + resultados.length);

        } catch (SQLException e) {
            e.printStackTrace();
        }
    }
}
