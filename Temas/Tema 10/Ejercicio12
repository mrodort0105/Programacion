import java.sql.*;

public class Ejercicio12 {
    private static final String URL = "jdbc:mariadb://localhost:3306/tienda";
    private static final String USER = "root";
    private static final String PASSWORD = "root";

    public static void main(String[] args) {
        try (Connection conn = DriverManager.getConnection(URL, USER, PASSWORD)) {
            DatabaseMetaData dbMeta = conn.getMetaData();

            System.out.println("--- METADATOS DE LA CONEXIÓN ---");
            System.out.println("URL de Conexión: " + dbMeta.getURL());
            System.out.println("Usuario: " + dbMeta.getUserName());
            System.out.println("SGBD: " + dbMeta.getDatabaseProductTitle() + " v" + dbMeta.getDatabaseProductVersion());
            System.out.println("Driver: " + dbMeta.getDriverName() + " v" + dbMeta.getDriverVersion());
            System.out.println("--------------------------------\n");

            // 1. Tablas de la base de datos "tienda"
            System.out.println("Tablas en la BD:");
            try (ResultSet tablas = dbMeta.getTables("tienda", null, "%", new String[]{"TABLE"})) {
                while (tablas.next()) {
                    System.out.println(" - Tabla: " + tablas.getString("TABLE_NAME"));
                }
            }

            // 2. Columnas de la tabla "productos"
            System.out.println("\nColumnas de la tabla 'productos':");
            try (ResultSet columnas = dbMeta.getColumns("tienda", null, "productos", "%")) {
                while (columnas.next()) {
                    System.out.println(" - Columna: " + columnas.getString("COLUMN_NAME") + 
                                       " | Tipo: " + columnas.getString("TYPE_NAME") + 
                                       " | Tamaño: " + columnas.getInt("COLUMN_SIZE"));
                }
            }

        } catch (SQLException e) {
            e.printStackTrace();
        }
    }
}
